<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 to match the server itself - confirmed from SPT_Runtime\SPT.Server.runtimeconfig.json
      ("tfm": "net10.0"). This is deliberately NOT the client mod's netstandard2.1: the client half
      of this mod runs inside Unity/BepInEx, the server half runs inside the SPT server process.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>QuestTreeServer</RootNamespace>
    <AssemblyName>QuestTreeServer</AssemblyName>
    <Nullable>enable</Nullable>
    <!--
      XML doc generation, on for ONE reason: it is what turns the doc-comment analysers on. Nothing
      reads the .xml.

      This codebase treats doc comments as documentation - they carry measurements, negative results
      and the reasons a thing is the way it is - so a comment with a dangling paramref, an unresolvable
      cref, raw angle brackets read as tags, or params documented for some arguments and not others is
      a real defect. Eight of those had accumulated invisibly across both halves, because with no doc
      file the compiler never raises CS1570-CS1574 or CS1734 at all.

      What it does NOT catch, and the reason a manual pass is still owed: a doc block carrying two
      <summary> elements raises nothing. Twenty-eight of those remain.

      DocumentationFile is deliberately NOT set. The SDK's own default for GenerateDocumentationFile
      already writes it under obj\; naming it here put it in the project ROOT instead - untracked, in
      the source tree, 375 KB, one `git add -A` from being committed - because $(IntermediateOutputPath)
      is not defined until Sdk.targets and evaluates to empty in this PropertyGroup.

      The SDK then copies it to the output directory as well, which DropDocXmlFromOutput below undoes:
      this project's convention is that a release can be assembled from bin\ alone, so bin\ holds
      exactly what ships.

      CS1591 is suppressed: it wants a summary on every public member, a different and much weaker rule
      than the one being enforced here, and it would bury the useful warnings under hundreds.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <!-- MSBuild cannot read the C# constant, so this is the one copy that has to be updated by
         hand: keep it equal to ModInfo.Version in ModInfo.cs, which everything else derives from. -->
    <AssemblyVersion>1.13.1</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Title>QuestTreeServer</Title>
    <Product>QuestTreeServer</Product>
    <Description>Serves the complete, unfiltered quest list to the Quest Tracker client mod.</Description>
    <!-- Nothing here is a NuGet dependency, so no deps file is wanted next to the mod DLL. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!--
    Path to the root of the SPT install (the folder containing SPT_Runtime\ and BepInEx\).
    Resolution order matches the client project's QuestTree.csproj:
      1) -p:SptPath="C:\Path\To\SPT" on the build command line
      2) the SPT_PATH environment variable
      3) two folders up
  -->
  <PropertyGroup>
    <SptPath Condition="'$(SptPath)' == '' AND '$(SPT_PATH)' != ''">$(SPT_PATH)</SptPath>
    <SptPath Condition="'$(SptPath)' == ''">$(MSBuildProjectDirectory)\..\..</SptPath>
    <ServerPath>$(SptPath)\SPT_Runtime</ServerPath>

    <!--
      Whether a build also installs itself into the SPT folder. OFF by default: the install is
      managed outside this repo (a mod manager, a reinstall), and a build that silently puts back
      a mod the user had removed is a surprise nobody asked for. Pass -p:DeployToSpt=true to get
      the old behaviour. SptPath is still resolved either way - the compile needs the game's and
      the server's DLLs to reference.
    -->
    <DeployToSpt Condition="'$(DeployToSpt)' == ''">false</DeployToSpt>
  </PropertyGroup>

  <!--
    Referenced as local DLLs rather than the SPTushonka.* NuGet packages on purpose: the server
    refuses to load a mod built against a different SPTarkov.Server.Core version than its own, and
    referencing the DLLs from this exact install makes a version mismatch impossible. Same
    HintPath-off-SptPath convention the client project already uses.
  -->
  <Target Name="CheckSptPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ServerPath)\SPTarkov.Server.Core.dll')"
           Text="SptPath '$(SptPath)' is not an SPT install (no SPT_Runtime\SPTarkov.Server.Core.dll). Pass -p:SptPath=&quot;C:\Path\To\SPT&quot; or set SPT_PATH." />
  </Target>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(ServerPath)\SPTarkov.Server.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(ServerPath)\SPTarkov.DI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(ServerPath)\SPTarkov.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- IModMetadata.SptVersion/Version are SemanticVersioning types, not System.Version. -->
    <Reference Include="SemanticVersioning">
      <HintPath>$(ServerPath)\SemanticVersioning.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Git's short hash, and "-dirty" when the tree has uncommitted changes, appended to the
       informational version (1.7.1+0c50f09-dirty) so two builds that both say 1.7.1 can be told
       apart from the log line. Tolerates no git at all: the stamp is then just the version. -->
  <Target Name="ReadGitStamp" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git describe --always --dirty --exclude &quot;*&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <!--
    Server mods live in SPT_Runtime\user\mods\<mod folder>\ in SPT 4.1 - NOT SPT\user\mods, which
    is the 4.0 location.
  -->
  <!--
    The trained build history, into the build output under cache\ so a release can be assembled from
    bin\ alone - the same reason kappa-quests.json is an output item in the client project.
  -->
  <ItemGroup>
    <None Include="weapon-builds.json" Link="cache\weapon-builds.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyToServerMods" AfterTargets="PostBuildEvent" Condition="'$(DeployToSpt)' == 'true'">
    <MakeDir Directories="$(ServerPath)\user\mods\QuestTree" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerPath)\user\mods\QuestTree\" SkipUnchangedFiles="true" />

    <!--
      COPY-IF-ABSENT, never overwrite, exactly as the client project treats kappa-quests.json - and here
      the reason is stronger than politeness. The file in the install is not a copy of ours: every launch
      writes back whatever smaller builds it found, so a player's file is the accumulated result of their
      own launches against THEIR item database. Ours is a head start for a first boot and nothing more,
      and overwriting theirs on a rebuild would discard every round they have ever run.
    -->
    <MakeDir Directories="$(ServerPath)\user\mods\QuestTree\cache" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\weapon-builds.json"
          DestinationFolder="$(ServerPath)\user\mods\QuestTree\cache\"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(ServerPath)\user\mods\QuestTree\cache\weapon-builds.json')" />
  </Target>


  <!-- See the DocumentationFile note above: the .xml exists to make the compiler check the comments,
       and nothing ships it, so it does not belong beside the DLL. -->
  <Target Name="DropDocXmlFromOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutDir)$(AssemblyName).xml" ContinueOnError="true" />
  </Target>

</Project>
