# Build output - regenerated by `dotnet build`, and the DLLs are deployed into the
# SPT install rather than consumed from here.
bin/
obj/

# Visual Studio / Rider local state
.vs/
.idea/
*.user
*.suo

# Packaged zips and staging folders are build artifacts. The release notes are not: package.ps1
# refuses to run without RELEASE-NOTES-<version>.md, so they have to exist in a clone.
Releases/*
!Releases/RELEASE-NOTES-*.md

# Internal planning and engineering log, kept locally rather than published. Both are
# working notes about how the work was done - stop rules, negative results, what was tried
# and retracted - and they are for whoever is doing the work, not for whoever installs the
# mod. The ledger in particular is only useful next to the scratchpad it cites.
ROADMAP.md
weapon-solver-ledger.md

# UI readability backlog - the same kind of working notes as ROADMAP.md, kept local for the
# same reason.
quest-tree-readability-spec.md

# Third-party data the server fetches into the install at runtime. Neither carries a licence that
# allows redistribution, so neither may ever be in a release - package.ps1 refuses a zip that
# contains either - and neither belongs in the repo.
objective-gps.json
tarkovdev-quests.json

# SPT wiki export for reading the 4.1.x changes - third-party text, kept local.
spt_wiki_export.md
