# Build output - regenerated by `dotnet build`, and the DLLs are deployed into the
# SPT install rather than consumed from here.
bin/
obj/

# Visual Studio / Rider local state
.vs/
.idea/
*.user
*.suo

# Packaged zips are build artifacts. The README they ship is versioned at the repo root
# instead, so it cannot be lost with a cleared temp folder the way it nearly was.
Releases/

# Internal planning and engineering log, kept locally rather than published. Both are
# working notes about how the work was done - stop rules, negative results, what was tried
# and retracted - and they are for whoever is doing the work, not for whoever installs the
# mod. The ledger in particular is only useful next to the scratchpad it cites.
ROADMAP.md
weapon-solver-ledger.md
